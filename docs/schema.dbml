Enum user_role {
  customer
  admin
}

Enum order_status {
  pending
  paid
  shipped
  cancelled
}

Enum payment_status {
  pending
  succeeded
  failed
}

Table categories {
  id bigint [pk, increment]
  name text [not null, unique]
  parent_id bigint [ref: > categories.id, note: 'NULL = top-level category']
  created_at timestamptz [not null, default: `now()`]
}

Table products {
  id bigint [pk, increment]
  category_id bigint [ref: > categories.id]
  name text [not null]
  description text
  price_cents integer [not null, note: 'CHECK >= 0']
  stock integer [not null, note: 'CHECK >= 0']
  is_active boolean [not null, default: true, note: 'soft delete']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    `lower(name)` [unique]
    category_id
  }
}

Table users {
  id bigint [pk, increment]
  email text [not null, unique]
  password_hash text [not null]
  full_name text [not null]
  role user_role [not null, default: 'customer']
  created_at timestamptz [not null, default: `now()`]
}

Table addresses {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  line1 text [not null]
  city text [not null]
  country text [not null]
  postal_code text
  indexes { user_id }
}

Table orders {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  status order_status [not null, default: 'pending']
  total_cents bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { (user_id, created_at) }
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  product_id bigint [not null, ref: > products.id]
  quantity integer [not null, note: 'CHECK > 0']
  unit_price_cents integer [not null, note: 'price copied at purchase time']
  indexes {
    order_id
    product_id
  }
}

Table payments {
  id bigint [pk, increment]
  order_id bigint [not null, unique, ref: - orders.id]
  amount_cents bigint [not null]
  status payment_status [not null, default: 'pending']
  provider_ref text
  idempotency_key text [unique]
  created_at timestamptz [not null, default: `now()`]
}

Table carts {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: - users.id]
  created_at timestamptz [not null, default: `now()`]
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null, ref: > carts.id]
  product_id bigint [not null, ref: > products.id]
  quantity integer [not null, note: 'CHECK > 0']
  indexes {
    (cart_id, product_id) [unique]
  }
}

Table stock_movements {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  change integer [not null, note: 'positive = in, negative = out']
  reason text [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { product_id }
}